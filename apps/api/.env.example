APP_NAME="Talabix API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
SENTRY_LARAVEL_DSN=

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=talabix
DB_USERNAME=talabix
DB_PASSWORD=secret
DB_DUMP_USE_SINGLE_TRANSACTION=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=talabix

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="ops@talabix.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REVERB_APP_ID=talabix
REVERB_APP_KEY=talabix-key
REVERB_APP_SECRET=talabix-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

GOOGLE_MAPS_API_KEY=
MAPS_PROVIDER=google_maps
MAPS_AVERAGE_DRIVING_SPEED_KPH=28
GOOGLE_MAPS_LOCATION_BIAS=circle:50000@24.7136,46.6753
GOOGLE_MAPS_REGION=sa
GOOGLE_MAPS_TIMEOUT_SECONDS=2.5
GOOGLE_MAPS_FALLBACK_TO_DEMO=true
READINESS_CHECK_KEY=
DISPATCH_PICKUP_SLA_MINUTES=30
DISPATCH_PICKUP_SLA_WARNING_MINUTES=10
DELIVERY_EXCEPTION_RESPONSE_SLA_MINUTES=10
DELIVERY_EXCEPTION_RESPONSE_WARNING_MINUTES=3
DISPATCH_SLA_ALERT_THRESHOLD=1
SCRIBE_AUTH_KEY=

AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=

BACKUP_DISKS=local
BACKUP_NOTIFICATION_EMAIL="${MAIL_FROM_ADDRESS}"
BACKUP_ARCHIVE_PASSWORD=
BACKUP_VERIFY_ARCHIVE=true
BACKUP_MAX_AGE_DAYS=1
BACKUP_MAX_STORAGE_MB=5000
BACKUP_KEEP_ALL_DAYS=7
BACKUP_KEEP_DAILY_DAYS=16
BACKUP_KEEP_WEEKLY_WEEKS=8
BACKUP_KEEP_MONTHLY_MONTHS=4
BACKUP_KEEP_YEARLY_YEARS=2
BACKUP_DELETE_OLDEST_WHEN_USING_MORE_MB=5000

VITE_APP_NAME="${APP_NAME}"

NOTIFICATIONS_QUEUE=notifications
NOTIFICATIONS_MAX_ATTEMPTS=3
NOTIFICATIONS_RETRY_BACKOFF_SECONDS=60,300
NOTIFICATIONS_EMAIL_DRIVER=mail
NOTIFICATIONS_EMAIL_MAILER=${MAIL_MAILER}
NOTIFICATIONS_PUSH_DRIVER=log
NOTIFICATIONS_SMS_DRIVER=log
